[
	{
		"codeDescriptorWatches": [
			{
				"path": "[class]/_interface/_onTCP",
				"watches": [
					{
						"type": 66,
						"formula": "$className"
					},
					{
						"type": 66,
						"formula": "This:C1470"
					},
					{
						"type": 66,
						"formula": "$options.name"
					},
					{
						"type": 66,
						"formula": "$name"
					}
				]
			},
			{
				"path": "[class]/_Model/",
				"watches": [
					{
						"type": 66,
						"formula": "This:C1470.files",
						"expanded": true
					},
					{
						"type": 66,
						"formula": "OB Class:C1730(This:C1470).name"
					}
				]
			},
			{
				"path": "[class]/_Model/download",
				"watches": [
					{
						"type": 66,
						"formula": "$file",
						"expanded": true
					}
				]
			},
			{
				"path": "[class]/_Model/onDownload",
				"watches": [
					{
						"type": 66,
						"formula": "This:C1470.files"
					},
					{
						"type": 66,
						"formula": "$1"
					},
					{
						"type": 66,
						"formula": "//new expression"
					},
					{
						"type": 66,
						"formula": "This:C1470.files : ",
						"expanded": true
					},
					{
						"type": 66,
						"formula": "$downloaded",
						"expanded": true
					},
					{
						"type": 66,
						"formula": "This:C1470.options.chat_completion_model"
					},
					{
						"type": 66,
						"formula": "$downloaded.folder.folder($downloaded.path)"
					}
				]
			},
			{
				"path": "[class]/_Model/start",
				"watches": [
					{
						"type": 66,
						"formula": "This:C1470",
						"expanded": true
					},
					{
						"type": 66,
						"formula": "OB Instance of:C1731(This:C1470.event; cs:C1710.event.event)"
					},
					{
						"type": 66,
						"formula": "This:C1470.models()"
					},
					{
						"type": 66,
						"formula": "This:C1470.options.port"
					}
				]
			},
			{
				"path": "[class]/_models/",
				"watches": [
					{
						"type": 66,
						"formula": "This:C1470.files",
						"expanded": true
					}
				]
			},
			{
				"path": "[class]/_models/download",
				"watches": [
					{
						"type": 66,
						"formula": "$file"
					},
					{
						"type": 66,
						"formula": "This:C1470.files",
						"expanded": true
					},
					{
						"type": 66,
						"formula": "($file.folder.file($file.path).exists)"
					},
					{
						"type": 66,
						"formula": "($file.folder.file($file.path).size=$file.size)"
					},
					{
						"type": 66,
						"formula": "$file.folder.exists"
					}
				]
			},
			{
				"path": "[class]/_models/onDownload",
				"watches": [
					{
						"type": 66,
						"formula": "This:C1470",
						"expanded": true
					},
					{
						"type": 66,
						"formula": "$that"
					}
				]
			},
			{
				"path": "[databaseMethod]/onStartup",
				"watches": [
					{
						"type": 66,
						"formula": "$t"
					},
					{
						"type": 66,
						"formula": "$embeddings",
						"expanded": true
					}
				]
			},
			{
				"path": "start",
				"watches": [
					{
						"type": 66,
						"formula": "$options.options"
					}
				]
			}
		]
	}
]